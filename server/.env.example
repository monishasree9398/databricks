# Server Port
PORT=3001

# Data Adapter Toggle
USE_DATABRICKS=false

# Databricks Lakehouse SQL Configuration
DATABRICKS_HOST=https://<your-workspace-instance>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/endpoints/<your-sql-warehouse-id>
DATABRICKS_TOKEN=dapi_your_personal_access_token_here

# Databricks Genie / Mosaic AI Endpoint
DATABRICKS_GENIE_SPACE_ID=01ef_genie_space_id_here
DATABRICKS_MODEL_SERVING_ENDPOINT=https://<your-workspace-instance>.cloud.databricks.com/serving-endpoints/databricks-dbrx-instruct/invocations
